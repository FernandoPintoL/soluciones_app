# ========================================
# CONFIGURACIÓN DE LA APLICACIÓN
# ========================================
APP_NAME="GESTOR INVENTARIOS"
APP_VERSION=1.0.0
APP_DEBUG=true

# ========================================
# CONFIGURACIÓN DEL SERVIDOR
# ========================================
# Local Development
# BASE_URL_WEB=http://192.168.100.36:9000
# BASE_URL=http://192.168.100.36:9000/api
# BASE_URL_IMG=http://192.168.100.36:9000/storage/

# Production (descomenta para usar)
BASE_URL_WEB=https://ventafacil.up.railway.app/
BASE_URL=https://ventafacil.up.railway.app/api
BASE_URL_IMG=https://ventafacil.up.railway.app/storage/

# ========================================
# CONFIGURACIÓN DE API
# ========================================
API_TIMEOUT=30
API_RETRY_COUNT=3

# ========================================
# CONFIGURACIÓN DE ALMACENAMIENTO
# ========================================
STORAGE_PATH=products
CACHE_ENABLED=true
CACHE_DURATION=3600